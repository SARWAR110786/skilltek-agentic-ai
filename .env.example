# Public site URL (used for SEO metadata / canonical links)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Where the Apply form POSTs JSON (an n8n Webhook node works well)
NEXT_PUBLIC_APPLY_WEBHOOK_URL=
# Shown in the Contact section; used as fallback if no webhook is set
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
# WhatsApp number, digits only with country code (e.g. 923001234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ── Saru Assistant (server-only — keep secret, never NEXT_PUBLIC_) ──
# Production URLs of the n8n "Saru Assistant" workflow's two webhooks
N8N_TEXT_CHAT_WEBHOOK=
N8N_VOICE_WEBHOOK=
# Shared key: must equal the value checked in the n8n webhooks' "Only run if" option
SARU_N8N_SECRET=
# Live streaming voice: production URL of the n8n "Saru Assistant - Realtime Voice Session" webhook
N8N_REALTIME_WEBHOOK=
